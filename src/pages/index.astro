---
import Base from "../layouts/Base.astro";
import { readFileSync } from "node:fs";
import { join } from "node:path";
const html = readFileSync(join(process.cwd(), "src/fragments/index.html"), "utf8");
---

<Base title="House of Artist Entertainment LLP" description="House of Artist is a creative platform connecting artists, organizers and brands." loader>
	<Fragment set:html={html} />
</Base>
