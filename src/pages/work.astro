---
import Base from "../layouts/Base.astro";
import { readFileSync } from "node:fs";
import { join } from "node:path";
const html = readFileSync(join(process.cwd(), "src/fragments/work.html"), "utf8");
---

<Base title="Our work · House of Artist" description="Concerts, campaigns and films produced with our artists and partners.">
	<Fragment set:html={html} />
</Base>
