---
interface Props {
  title: string;
  description: string;
  loader?: boolean;
}
const { title, description, loader = false } = Astro.props;
import { readFileSync } from "node:fs";
import { join } from "node:path";
const loaderHtml = loader ? readFileSync(join(process.cwd(), "src/fragments/loader.html"), "utf8") : "";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body style="margin: 0">
		{loader && <Fragment set:html={loaderHtml} />}
		<slot />
		<script src="/js/site.js" defer></script>
	</body>
</html>
